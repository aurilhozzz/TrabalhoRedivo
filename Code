### 6. Service (`service/HabitoService.java`)

```java
package com.habitos.api.service;

import com.habitos.api.dto.HabitoDTO;
import com.habitos.api.mapper.HabitoMapper;
import com.habitos.api.model.Habito;
import com.habitos.api.repository.HabitoRepository;
import jakarta.persistence.EntityNotFoundException;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.stream.Collectors;

@Service
public class HabitoService {

    @Autowired
    private HabitoRepository repository;

    @Autowired
    private HabitoMapper mapper;

    public List<HabitoDTO> listarTodos() {
        return repository.findAll().stream()
                .map(mapper::toDTO)
                .collect(Collectors.toList());
    }

    public HabitoDTO buscarPorId(Long id) {
        Habito habito = repository.findById(id)
                .orElseThrow(() -> new EntityNotFoundException("Hábito não encontrado com o ID: " + id));
        return mapper.toDTO(habito);
    }

    public HabitoDTO criar(HabitoDTO dto) {
        Habito habito = mapper.toEntity(dto);
        if (habito.getStreakDias() == null) {
            habito.setStreakDias(0);
        }
        if (habito.getFeitoHoje() == null) {
            habito.setFeitoHoje(false);
        }
        Habito salvo = repository.save(habito);
        return mapper.toDTO(salvo);
    }

    public HabitoDTO atualizar(Long id, HabitoDTO dto) {
        Habito existente = repository.findById(id)
                .orElseThrow(() -> new EntityNotFoundException("Hábito não encontrado com o ID: " + id));

        existente.setNome(dto.getNome());
        existente.setFrequencia(dto.getFrequencia());
        if (dto.getStreakDias() != null) {
            existente.setStreakDias(dto.getStreakDias());
        }
        existente.setDescricao(dto.getDescricao());
        if (dto.getFeitoHoje() != null) {
            existente.setFeitoHoje(dto.getFeitoHoje());
        }

        Habito atualizado = repository.save(existente);
        return mapper.toDTO(atualizado);
    }

    public void remover(Long id) {
        if (!repository.existsById(id)) {
            throw new EntityNotFoundException("Hábito não encontrado com o ID: " + id);
        }
        repository.deleteById(id);
    }

    public HabitoDTO concluirHoje(Long id) {
        Habito habito = repository.findById(id)
                .orElseThrow(() -> new EntityNotFoundException("Hábito não encontrado com o ID: " + id));

        habito.setFeitoHoje(true);
        habito.setStreakDias(habito.getStreakDias() + 1);

        Habito atualizado = repository.save(habito);
        return mapper.toDTO(atualizado);
    }
}

```

