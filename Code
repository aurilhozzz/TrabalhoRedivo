### 4. Mapper (`mapper/HabitoMapper.java`)

```java
package com.habitos.api.mapper;

import com.habitos.api.dto.HabitoDTO;
import com.habitos.api.model.Habito;
import org.springframework.stereotype.Component;

@Component
public class HabitoMapper {

    public Habito toEntity(HabitoDTO dto) {
        if (dto == null) return null;
        Habito habito = new Habito();
        habito.setId(dto.getId());
        habito.setNome(dto.getNome());
        habito.setFrequencia(dto.getFrequencia());
        habito.setStreakDias(dto.getStreakDias() != null ? dto.getStreakDias() : 0);
        habito.setDescricao(dto.getDescricao());
        habito.setFeitoHoje(dto.getFeitoHoje() != null ? dto.getFeitoHoje() : false);
        return habito;
    }

    public HabitoDTO toDTO(Habito entity) {
        if (entity == null) return null;
        HabitoDTO dto = new HabitoDTO();
        dto.setId(entity.getId());
        dto.setNome(entity.getNome());
        dto.setFrequencia(entity.getFrequencia());
        dto.setStreakDias(entity.getStreakDias());
        dto.setDescricao(entity.getDescricao());
        dto.setFeitoHoje(entity.getFeitoHoje());
        return dto;
    }
}

